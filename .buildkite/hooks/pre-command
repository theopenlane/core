#!/bin/bash

set -euo pipefail

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/cleanup.sh"

renovate_or_fork=false
[[ "${BUILDKITE_BRANCH:-}" =~ ^renovate/ || "${BUILDKITE_BRANCH:-}" =~ : ]] && renovate_or_fork=true

# a pipeline or build can force the build type, to test priority and limits without a real pr or tag
build_type="${OPENLANE_BUILD_TYPE:-}"
if [[ -z "$build_type" ]]; then
  if [[ -n "${BUILDKITE_TAG:-}" ]]; then
    build_type=tag
  elif [[ -n "${BUILDKITE_PULL_REQUEST:-}" && "${BUILDKITE_PULL_REQUEST}" != "false" && "$renovate_or_fork" == false ]]; then
    build_type=pr
  elif [[ "${BUILDKITE_BRANCH:-}" == "main" ]]; then
    build_type=main
  else
    build_type=other
  fi
fi

case "$build_type" in
  tag) OPENLANE_BUILDKITE_JOB_PRIORITY=100 ;;
  pr) OPENLANE_BUILDKITE_JOB_PRIORITY=80 ;;
  main) OPENLANE_BUILDKITE_JOB_PRIORITY=50 ;;
  *)
    OPENLANE_BUILDKITE_JOB_PRIORITY=0
    if [[ "$renovate_or_fork" == true ]]; then
      OPENLANE_BUILDKITE_JOB_PRIORITY=-10
    fi
    ;;
esac

export OPENLANE_BUILDKITE_JOB_PRIORITY

# namespace shares one instance limit across every build, so each build type gets its own concurrency groups
# lower types are capped so they cannot crowd out tags and pull requests, values are large medium small
limits=()
if [[ "${LARGE_RUNNER_QUEUE:-}" == "namespace" ]]; then
  pool=namespace
  case "$build_type" in
    tag) limits=(100 100 100) ;;
    pr) limits=(3 4 2) ;;
    main) limits=(1 2 1) ;;
    *) limits=(1 1 1) ;;
  esac
else
  pool=self-hosted
  # self-hosted agents already pick waiting jobs by priority, only cap the lowest type so it cannot hold every agent
  case "$build_type" in
    other) limits=(2 2 2) ;;
  esac
fi

if [[ ${#limits[@]} -eq 3 ]]; then
  export LARGE_CONCURRENCY_GROUP="${pool}/${build_type}/large"
  export LARGE_CONCURRENCY="${limits[0]}"
  export MEDIUM_CONCURRENCY_GROUP="${pool}/${build_type}/medium"
  export MEDIUM_CONCURRENCY="${limits[1]}"
  export SMALL_CONCURRENCY_GROUP="${pool}/${build_type}/small"
  export SMALL_CONCURRENCY="${limits[2]}"
fi

# step tiers within a build, generate first then lint and tests, kept below the gaps between build types
export OPENLANE_BUILDKITE_PRIORITY_TOP=$((OPENLANE_BUILDKITE_JOB_PRIORITY + 4))
export OPENLANE_BUILDKITE_PRIORITY_HIGH=$((OPENLANE_BUILDKITE_JOB_PRIORITY + 3))
export OPENLANE_BUILDKITE_PRIORITY_MEDIUM=$((OPENLANE_BUILDKITE_JOB_PRIORITY + 2))
export OPENLANE_BUILDKITE_PRIORITY_LOW=$((OPENLANE_BUILDKITE_JOB_PRIORITY + 1))

echo "🔧 Setting up build environment..."

# Create cache directories (tools may not be available yet)
ensure_cache_dirs

# Docker layer caching setup (Docker handled via plugins)
export DOCKER_BUILDKIT=1
export COMPOSE_DOCKER_CLI_BUILD=1

# Basic tool availability checks (only for tools that should be on base VM)
echo "🔍 Checking base system tools..."
if ! command -v git >/dev/null 2>&1; then
  echo "❌ Git not found in PATH"
  exit 1
fi

# Common environment validation
if [[ -z "${BUILDKITE_BUILD_ID:-}" ]]; then
  echo "⚠️  Not running in Buildkite environment"
fi

# Check disk space before starting build
echo "📊 Checking disk space..."
if is_hosted_runner; then
  echo "☁️  Hosted runner, skipping disk cleanup"
elif disk_usage=$(disk_usage_percent); then
  echo "📊 Current disk usage: ${disk_usage}%"

  if [[ $disk_usage -ge $CACHE_CLEANUP_THRESHOLD ]]; then
    echo "🧹 Disk usage is at or over ${CACHE_CLEANUP_THRESHOLD}%, pruning caches oldest first..."

    free_disk_to_threshold
    report_disk_after "$disk_usage"

    if disk_usage=$(disk_usage_percent) && [[ $disk_usage -ge $DISK_RETRY_THRESHOLD ]]; then
      echo "🚨 Disk usage is still ${disk_usage}% after cleanup, exiting ${DISK_RETRY_EXIT_CODE} so the pipeline retries the job"
      exit "$DISK_RETRY_EXIT_CODE"
    fi
  fi
else
  echo "⚠️  Could not determine disk usage, skipping disk space check"
fi

echo "✅ Build environment setup complete"
