#!/bin/bash

set -euo pipefail

# cleanup must never fail the job, so any error is logged and the hook still exits 0
trap 'status=$?; if [[ $status -ne 0 ]]; then echo "⚠️  Post-command cleanup failed with exit status ${status}, ignoring"; fi; exit 0' EXIT

source "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib/cleanup.sh"

# hosted runners start each job on a fresh instance, so there is nothing to clean up
if is_hosted_runner; then
    echo "☁️  Hosted runner, skipping post-command cleanup"
    exit 0
fi

echo "🧹 Running post-command cleanup..."

# Check if command succeeded or failed
if [[ "${BUILDKITE_COMMAND_EXIT_STATUS:-0}" -ne 0 ]]; then
    echo "⚠️  Command failed with exit status: ${BUILDKITE_COMMAND_EXIT_STATUS}"
fi

# Clean up temporary files from this build step
if [[ -n "${BUILDKITE_BUILD_PATH:-}" ]]; then
    # Clean up any temp files that might have been created
    find "${BUILDKITE_BUILD_PATH}" -name "*.tmp" -type f -delete 2>/dev/null || true
    find "${BUILDKITE_BUILD_PATH}" -name "*.temp" -type f -delete 2>/dev/null || true
fi

# Prune the go build, go module, and golangci-lint caches
prune_build_caches

# Docker cleanup
if command -v docker >/dev/null 2>&1; then
    echo "🐳 Running Docker cleanup..."

    # Get initial disk usage
    if initial_usage=$(disk_usage_percent); then
        echo "📊 Initial disk usage: ${initial_usage}%"
    else
        echo "⚠️  Could not determine initial disk usage, running cleanup anyway"
        initial_usage=0
    fi

    prune_docker_unused
    prune_docker_stale

    # Final disk usage check
    report_disk_after "$initial_usage"

    # Show Docker space usage summary
    echo "🐳 Docker space usage summary:"
    docker system df 2>/dev/null || true
fi

echo "✅ Post-command cleanup complete"