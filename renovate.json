{
    "extends": [
        "config:recommended"
    ],
    "postUpdateOptions": [
        "gomodTidyAll",
        "gomodUpdateImportPaths"
    ],
    "gitIgnoredAuthors": [
        "*bender*"
    ],
    "labels": [
        "dependencies"
    ],
    "minimumReleaseAge": "7 days",
    "packageRules": [
        {
            "groupName": "all patch dependencies",
            "groupSlug": "all-patch",
            "matchPackageNames": [
                "*"
            ],
            "matchUpdateTypes": [
                "patch"
            ]
        },
        {
            "description": "our own releases do not need to wait out the release age",
            "matchPackageNames": [
                "github.com/theopenlane/**",
                "ghcr.io/theopenlane/**",
                "theopenlane/**"
            ],
            "minimumReleaseAge": null
        }
    ]
}
