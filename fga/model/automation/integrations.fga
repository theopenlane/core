module automation

# integrations represent configured org connections to providers
type integration
  relations
    # base permissions - these should all be derived permissions
    define can_view: (viewer but not blocked)
    define can_edit: (editor but not blocked) or can_delete
    define can_delete: (editor but not blocked)

    # tuple based permissions for edit, view, blocked, and audit log viewing
    define editor: [user, service, group#member] or parent_editor
    define viewer: [user, service, group#member] or editor or parent_viewer
    define blocked: [user, service, group#member]
    define audit_log_viewer: (([user, service, group#member] or audit_log_viewer from parent or audit_log_viewer from parent_context) and can_view) or can_view

    # parent permissions derived based on `crud` permissions or parents
    define parent_editor: can_edit from parent_context or can_edit from parent
    # todo (sfunk): remove after integration edges cleaned up in UI so you need can_manage_integrations instead of can_view
    define parent_viewer: can_view from parent_context or can_view from parent
    define parent_context: [organization]
    define parent: [platform]


# webhooks configured for integrations
type integration_webhook
  relations
    # base permissions - these should all be derived permissions
    define can_view: (viewer but not blocked)
    define can_edit: (editor but not blocked) or can_delete
    define can_delete: (editor but not blocked)

    # tuple based permissions for edit, view, blocked, and audit log viewing
    define editor: [user, service, group#member] or parent_editor
    define viewer: [user, service, group#member] or editor or parent_viewer
    define blocked: [user, service, group#member]
    define audit_log_viewer: (([user, service, group#member] or audit_log_viewer from parent_context) and can_view) or can_view

    # parent permissions derived based on `crud` permissions or parents
    define parent_editor: can_edit from parent_context
    # webhooks are only visible to integration managers, not every org member
    define parent_viewer: can_manage_integrations from parent_context
    define parent_context: [organization]


# integration run history is service-driven and only visible to integration managers
type integration_run
  relations
    # base permissions - these should all be derived permissions
    # runs have no direct or blocked access, the integration manager read skipper relies on that
    define can_view: viewer
    define can_edit: editor or can_delete
    define can_delete: editor

    # tuple based permissions for edit, view, and audit log viewing
    define editor: [service]
    define viewer: editor or parent_viewer
    define audit_log_viewer: (([user, service, group#member] or audit_log_viewer from parent_context) and can_view) or can_view

    # parent permissions derived based on `crud` permissions or parents
    define parent_viewer: can_manage_integrations from parent_context
    define parent_context: [organization]
