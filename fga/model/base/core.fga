module base

# this file contains all top level definitions used through all fga models

# user is a human with access to the system
# the _self relation is used for when the user is the parent of another object
type user
  relations
    define _self: [user]
    define can_view: _self
    define can_edit: _self
    define can_delete: _self
    define viewer: _self
    define editor: _self
    define can_view_org: _self
    define audit_log_viewer: _self
    define audit_org: [organization]
    define can_view_audit: audit_log_viewer from audit_org
    # always empty, a user or service is never blocked on itself, defined so `blocked from parent`
    # resolves when a user or service is the parent of an object (weighted graph requires it on every parent type)
    define blocked: _self but not _self

# service is not associated to a particular user, but instead to an organization
# the _self relation is used for when the service is the parent of another object
type service
  relations
    define _self: [service]
    define can_view: _self
    define can_edit: _self
    define can_delete: _self
    define viewer: _self
    define editor: _self
    define audit_log_viewer: _self
    # always empty, a user or service is never blocked on itself, defined so `blocked from parent`
    # resolves when a user or service is the parent of an object (weighted graph requires it on every parent type)
    define blocked: _self but not _self

# search access for the admin search
type search
  relations
    define admin: [user]

# system admin roles are used to define the highest level of access in the system
type system
  relations
    define system_admin: [user, service]

type feature
  relations
    define enabled: [organization]

