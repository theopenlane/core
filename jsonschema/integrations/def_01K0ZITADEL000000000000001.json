        "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/zitadel/credential-schema",
        "$ref": "#/$defs/CredentialSchema",
        "$defs": {
          "CredentialSchema": {
            "properties": {
              "domain": {
                "type": "string",
                "title": "Domain",
                "description": "Zitadel instance domain (e.g. my-instance.zitadel.cloud). Uses TLS by default; prefix with http:// for a non-TLS self-hosted instance."
              },
              "token": {
                "type": "string",
                "title": "Personal Access Token"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "domain",
              "token"
            ]
          }
        }
      }
    },
    {
      "ref": "OAuthCredentialSchema",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
