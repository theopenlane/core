        "$ref": "#/$defs/OAuthCredentialSchema",
        "$defs": {
          "OAuthCredentialSchema": {
            "properties": {
              "domain": {
                "type": "string",
                "title": "Domain",
                "description": "Zitadel instance domain (e.g. my-instance.zitadel.cloud). Uses TLS by default; prefix with http:// for a non-TLS self-hosted instance."
              },
              "clientId": {
                "type": "string",
                "title": "Client ID"
              },
              "clientSecret": {
                "type": "string",
                "title": "Client Secret"
              }
            },
