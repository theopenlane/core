            },
            "filterExpr": {
              "type": "string",
              "title": "Filter Expression",
              "description": "Optional CEL expression to apply to records before ingesting",
              "examples": [
                "Example: payload.ComplianceType == 'NON_COMPLIANT' || payload.ComplianceType == 'COMPLIANT'"
              ]
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "DirectorySync": {
          "properties": {
            "disable": {
              "type": "boolean",
              "title": "Disable",
              "description": "Disable this sync"
            },
            "disableGroupSync": {
              "type": "boolean",
              "title": "Disable Group Sync",
              "description": "Only sync users from AWS IAM"
            },
            "filterExpr": {
              "type": "string",
              "title": "Filter Expression",
              "description": "Optional CEL expression to apply to records before ingesting.",
              "examples": [
                "Example: payload.path.startsWith('/engineering/')"
              ]
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "FindingSync": {
          "properties": {
            "disable": {
              "type": "boolean",
              "title": "Disable",
              "description": "Disable this sync"
            },
            "filterExpr": {
              "type": "string",
              "title": "Filter Expression",
              "description": "Optional CEL expression to apply to records before ingesting",
              "examples": [
                "Example: payload.Severity.Label == 'CRITICAL' || payload.Severity.Label == 'HIGH'"
              ]
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "UserInput": {
          "properties": {
            "findingSync": {
              "$ref": "#/$defs/FindingSync",
              "title": "AWS Security Hub Sync"
            },
            "directorySync": {
              "$ref": "#/$defs/DirectorySync",
              "title": "Directory Account Sync"
            },
            "checkSync": {
              "$ref": "#/$defs/CheckSync",
              "title": "AWS Config Rule Sync"
            },
            "assetSync": {
              "$ref": "#/$defs/AssetSync",
              "title": "AWS Asset Sync"
            }
          },
          "additionalProperties": false,
          "type": "object"
        }
      }
    }
  },
