              "description": "Disable this sync"
            },
            "filterExpr": {
              "type": "string",
              "title": "Filter Expression",
              "description": "Optional CEL expression to apply to records before ingesting"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "CheckSync": {
          "properties": {
