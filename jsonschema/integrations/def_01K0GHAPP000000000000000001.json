        "$ref": "#/$defs/UserInput",
        "$defs": {
          "DirectorySync": {
            "properties": {
              "disable": {
                "type": "boolean",
                "title": "Disable",
                "description": "Disable the syncing of users and groups from GitHub"
              },
              "disableGroupSync": {
                "type": "boolean",
