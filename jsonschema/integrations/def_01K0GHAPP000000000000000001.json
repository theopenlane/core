{
  "id": "def_01K0GHAPP000000000000000001",
  "credentials": [
    {
      "ref": "githubAppCredential",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/githubapp/github-app-credential",
        "$ref": "#/$defs/githubAppCredential",
        "$defs": {
          "githubAppCredential": {
            "properties": {
              "appId": {
                "type": "integer"
              },
              "installationId": {
                "type": "integer"
              },
              "accessToken": {
                "type": "string"
              },
              "expiry": {
                "type": "string",
                "format": "date-time"
              },
              "organizationName": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "type": "object"
          }
        }
      }
    }
  ],
  "userInput": {
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/githubapp/user-input",
      "$ref": "#/$defs/UserInput",
      "$defs": {
        "DirectorySync": {
          "properties": {
            "disable": {
              "type": "boolean",
              "title": "Disable",
              "description": "Disable this sync"
            },
            "disableGroupSync": {
              "type": "boolean",
              "title": "Disable Group Sync",
              "description": "Only sync users from GitHub"
            },
            "filterExpr": {
              "type": "string",
              "title": "Filter Expression",
              "description": "Optional CEL expression to apply to records before ingesting.",
              "examples": [
                "Example: payload.Org == 'my-org'"
              ]
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "RepositorySync": {
          "properties": {
            "disable": {
              "type": "boolean",
              "title": "Disable",
              "description": "Disable this sync"
            },
            "filterExpr": {
              "type": "string",
              "title": "Filter Expression",
              "description": "Optional CEL expression to apply to records before ingesting.",
              "examples": [
                "Example: payload.IsPrivate == 'true'"
              ]
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "UserInput": {
          "properties": {
            "findingSync": {
              "$ref": "#/$defs/VulnerabilitySync",
              "title": "GitHub Security Hub Sync"
            },
            "directorySync": {
              "$ref": "#/$defs/DirectorySync",
              "title": "Directory Account Sync"
            },
            "repositorySync": {
              "$ref": "#/$defs/RepositorySync",
              "title": "Repository Account Sync"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "VulnerabilitySync": {
          "properties": {
            "disable": {
              "type": "boolean",
              "title": "Disable",
              "description": "Disable this sync"
            },
            "filterExpr": {
              "type": "string",
              "title": "Filter Expression",
              "description": "Optional CEL expression to apply to records before ingesting.",
              "examples": [
                "Example: payload.state == 'open'"
              ]
            },
            "maxRepos": {
              "type": "integer",
              "title": "Max Repositories",
              "description": "Optional cap on the number of repositories to scan."
            }
          },
          "additionalProperties": false,
          "type": "object"
        }
      }
    }
  },
  "installation": {
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/githubapp/installation-metadata",
