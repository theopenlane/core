              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "RepositorySync": {
            "properties": {
              "disable": {
                "type": "boolean",
                "title": "Disable",
                "description": "Disable the syncing of repositories from GitHub"
              },
              "filterExpr": {
                "type": "string",
                "title": "Filter Expression",
                "description": "Optional CEL expression to apply to records before ingesting.",
                "examples": [
                  "Example: payload.IsPrivate == 'true'"
                ]
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "UserInput": {
            "properties": {
              "findingSync": {
                "$ref": "#/$defs/VulnerabilitySync",
                "title": "GitHub Security Hub Sync"
              },
              "directorySync": {
                "$ref": "#/$defs/DirectorySync",
                "title": "Directory Account Sync"
              },
              "repositorySync": {
                "$ref": "#/$defs/RepositorySync",
                "title": "Repository Account Sync"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "VulnerabilitySync": {
            "properties": {
              "disable": {
                "type": "boolean",
                "title": "Disable",
                "description": "Disable the syncing of vulnerabilities from GitHub"
              },
              "filterExpr": {
                "type": "string",
                "title": "Filter Expression",
                "description": "Optional CEL expression to apply to records before ingesting.",
                "examples": [
                  "Example: payload.state == 'open'"
                ]
              },
              "maxRepos": {
                "type": "integer",
                "title": "Max Repositories",
                "description": "Optional cap on the number of repositories to scan."
              }
            },
            "additionalProperties": false,
            "type": "object"
          }
        }
      }
