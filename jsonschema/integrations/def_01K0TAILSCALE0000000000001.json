        "$ref": "#/$defs/UserInput",
        "$defs": {
          "AssetSync": {
            "properties": {
              "disable": {
                "type": "boolean",
                "title": "Disable",
                "description": "Disable the syncing of devices from Tailscale"
              },
              "filterExpr": {
                "type": "string",
                "title": "Filter Expression",
                "description": "Optional CEL expression to apply to records before ingesting"
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "DirectorySync": {
            "properties": {
              "disable": {
                "type": "boolean",
