                "description": "Disable the syncing of users and groups from Tailscale"
              },
              "disableGroupSync": {
                "type": "boolean",
                "title": "Disable Group Sync",
                "description": "Only sync users from Tailscale; disable role-based group sync"
              },
              "filterExpr": {
                "type": "string",
                "title": "Filter Expression",
                "description": "Optional CEL expression to apply to records before ingesting",
                "examples": [
                  "Example: payload.status == 'active'"
                ]
              }
            },
            "additionalProperties": false,
            "type": "object"
          },
          "UserInput": {
            "properties": {
              "directorySync": {
                "$ref": "#/$defs/DirectorySync",
                "title": "Directory Sync"
              },
              "assetSync": {
                "$ref": "#/$defs/AssetSync",
                "title": "Asset Sync"
              }
            },
            "additionalProperties": false,
            "type": "object"
          }
        }
