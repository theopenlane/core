          "$ref": "#/$defs/CredentialSchema",
          "$defs": {
            "CredentialSchema": {
              "properties": {
                "clientId": {
                  "type": "string",
                  "title": "Client ID",
                  "description": "OAuth client ID from the Tailscale admin console."
                },
                "clientSecret": {
                  "type": "string",
                  "title": "Client Secret",
                  "description": "OAuth client secret from the Tailscale admin console."
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "clientId",
                "clientSecret"
              ]
            }
          }
        }
      }
    ],
    "userInput": {
      "schema": {
