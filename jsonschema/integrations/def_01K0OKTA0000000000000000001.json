            "enableGroupSync": {
              "type": "boolean",
              "title": "Sync Groups"
            },
            "primaryDirectory": {
              "type": "boolean",
              "title": "Primary Directory"
            }
          },
          "additionalProperties": false,
          "type": "object"
        }
      }
    }
  },
  "metadata": [
