        "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/gcpscc/installation-metadata",
        "$ref": "#/$defs/InstallationMetadata",
        "$defs": {
          "InstallationMetadata": {
            "properties": {
              "organizationId": {
                "type": "string",
                "title": "Organization ID"
              },
              "projectId": {
                "type": "string",
                "title": "Project ID"
              },
              "projectScope": {
                "type": "string",
                "title": "Project Scope"
              },
              "projectIds": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "title": "Project IDs"
              },
              "sourceIds": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "title": "SCC Source IDs",
                "description": "Filter which sources findings are pulled from"
              },
              "serviceAccountEmail": {
                "type": "string",
                "title": "Service Account Email"
              }
            },
            "additionalProperties": false,
            "type": "object"
          }
        }
      }
    }
  ],
  "connections": [
    "CredentialSchema",
    "WorkloadIdentityCredentialSchema"
  ],
  "operations": [
