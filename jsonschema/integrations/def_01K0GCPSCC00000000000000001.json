{
  "id": "def_01K0GCPSCC00000000000000001",
  "credentials": [
    {
      "ref": "CredentialSchema",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/gcpscc/credential-schema",
        "$ref": "#/$defs/CredentialSchema",
        "$defs": {
          "CredentialSchema": {
            "properties": {
              "serviceAccountKey": {
                "type": "string",
                "title": "Service Account Key JSON",
                "description": "Service Account JSON used to authenticate on your behalf to GCP SCC"
              },
              "organizationId": {
                "type": "string",
                "title": "Organization ID",
                "description": "The ID of the organization to use as the parent - either organization ID or project ID are required"
              },
              "projectId": {
                "type": "string",
                "title": "Project ID",
                "description": "The ID of the project to use as the parent - either organization ID or project ID are required"
              },
              "projectScope": {
                "type": "string",
                "enum": [
                  "all",
                  "specific"
                ],
                "title": "Project Scope",
                "description": "Filter project scope; only used if using an Organization ID as the initial filter",
                "default": "all"
              },
              "projectIds": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "title": "Project IDs",
                "description": "List of project IDs to include if the project scope is set to specific"
              },
              "sourceIds": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "title": "SCC Source IDs",
                "description": "Limit sources to include in pulling in findings from SCC"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "serviceAccountKey"
            ]
          }
        }
      }
    },
    {
      "ref": "WorkloadIdentityCredentialSchema",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/gcpscc/workload-identity-credential-schema",
        "$ref": "#/$defs/WorkloadIdentityCredentialSchema",
        "$defs": {
          "WorkloadIdentityCredentialSchema": {
            "properties": {
              "projectNumber": {
                "type": "string",
                "pattern": "^[0-9]+$",
                "title": "GCP Project Number",
                "description": "Numeric project number of the GCP project hosting the openlane workload identity pool and provider"
              },
              "serviceAccountEmail": {
                "type": "string",
                "title": "Service Account Email",
                "description": "Optional service account to impersonate"
              },
              "organizationId": {
                "type": "string",
                "title": "Organization ID",
                "description": "The ID of the organization to use as the parent - either organization ID or project ID are required"
              },
              "projectId": {
                "type": "string",
                "title": "Project ID",
                "description": "The ID of the project to use as the parent - either organization ID or project ID are required"
              },
              "projectScope": {
                "type": "string",
                "enum": [
                  "all",
                  "specific"
                ],
                "title": "Project Scope",
                "description": "Filter project scope; only used if using an Organization ID as the initial filter",
                "default": "all"
              },
              "projectIds": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "title": "Project IDs",
                "description": "List of project IDs to include if the project scope is set to specific"
              },
              "sourceIds": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "title": "SCC Source IDs",
                "description": "Limit sources to include in pulling in findings from SCC"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "projectNumber"
            ]
          }
        }
      }
    }
  ],
  "userInput": {
    "schema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/gcpscc/user-input",
      "$ref": "#/$defs/UserInput",
      "$defs": {
        "FindingsSyncConfig": {
          "properties": {
            "filterExpr": {
              "type": "string",
              "title": "Filter Expression",
              "description": "Optional CEL expression to apply to records before ingesting (allows inclusion",
              "examples": [
                "Example: payload.category != \"GKE_SECURITY_BULLETIN\""
              ]
            },
            "page_size": {
              "type": "integer"
            }
          },
          "additionalProperties": false,
          "type": "object"
        },
        "UserInput": {
          "properties": {
            "findingsSync": {
              "$ref": "#/$defs/FindingsSyncConfig",
              "title": "Findings Sync"
            }
          },
          "additionalProperties": false,
          "type": "object"
        }
      }
    }
  },
  "metadata": [
    {
      "connection": "CredentialSchema",
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/gcpscc/installation-metadata",
        "$ref": "#/$defs/InstallationMetadata",
        "$defs": {
          "InstallationMetadata": {
            "properties": {
              "organizationId": {
                "type": "string",
                "title": "Organization ID"
              },
              "projectId": {
                "type": "string",
                "title": "Project ID"
              },
              "projectScope": {
                "type": "string",
                "title": "Project Scope"
              },
              "projectIds": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "title": "Project IDs"
              },
              "sourceIds": {
                "items": {
                  "type": "string"
                },
                "type": "array",
                "title": "SCC Source IDs",
                "description": "Filter which sources findings are pulled from"
              },
              "serviceAccountEmail": {
                "type": "string",
                "title": "Service Account Email"
              }
            },
            "additionalProperties": false,
            "type": "object"
          }
        }
      }
    },
    {
