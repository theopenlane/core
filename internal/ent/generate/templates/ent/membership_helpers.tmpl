import (
	"context"
	"strings"

	"github.com/samber/lo"
	"github.com/stoewer/go-strcase"

	"github.com/theopenlane/core/common/enums"
	"github.com/theopenlane/core/internal/ent/generated/groupmembership"
	"github.com/theopenlane/core/internal/ent/generated/orgmembership"
	"github.com/theopenlane/core/internal/ent/generated/user"
)

// OrgRoleUserIDs returns the distinct user IDs holding any of the given roles in the
// organization. Privacy is the caller's concern: pass an appropriately elevated context
func (c *Client) OrgRoleUserIDs(ctx context.Context, orgID string, roles ...enums.Role) ([]string, error) {
	var userIDs []string

	err := c.OrgMembership.Query().
		Where(
			orgmembership.OrganizationIDEQ(orgID),
			orgmembership.RoleIn(roles...),
		).
		Select(orgmembership.FieldUserID).
		Scan(ctx, &userIDs)
	if err != nil {
		return nil, err
	}

	return lo.Uniq(userIDs), nil
}

// OrgRoleUsers returns the distinct users holding any of the given roles in the organization
func (c *Client) OrgRoleUsers(ctx context.Context, orgID string, roles ...enums.Role) ([]*User, error) {
	memberships, err := c.OrgMembership.Query().
		Where(
			orgmembership.OrganizationIDEQ(orgID),
			orgmembership.RoleIn(roles...),
		).
		WithUser().
		All(ctx)
	if err != nil {
		return nil, err
	}

	return lo.UniqBy(lo.FilterMap(memberships, func(membership *OrgMembership, _ int) (*User, bool) {
		return membership.Edges.User, membership.Edges.User != nil
	}), func(u *User) string { return u.ID }), nil
}

// GroupMemberUserIDs returns the distinct user IDs belonging to any of the given groups
func (c *Client) GroupMemberUserIDs(ctx context.Context, groupIDs ...string) ([]string, error) {
	groupIDs = lo.Compact(groupIDs)
	if len(groupIDs) == 0 {
		return nil, nil
	}

	var userIDs []string

	err := c.GroupMembership.Query().
		Where(groupmembership.GroupIDIn(groupIDs...)).
		Select(groupmembership.FieldUserID).
		Scan(ctx, &userIDs)
	if err != nil {
		return nil, err
	}

	return lo.Uniq(userIDs), nil
}

// UserInGroups reports whether the user belongs to any of the given groups
func (c *Client) UserInGroups(ctx context.Context, userID string, groupIDs ...string) (bool, error) {
	groupIDs = lo.Compact(groupIDs)
	if userID == "" || len(groupIDs) == 0 {
		return false, nil
	}

	return c.GroupMembership.Query().
		Where(
			groupmembership.UserIDEQ(userID),
			groupmembership.GroupIDIn(groupIDs...),
		).
		Exist(ctx)
}

// OrgMemberExistsByEmail reports whether a user with the given email is a member of the
// organization; emails are stored lowercased, so the input is lowered before matching
func (c *Client) OrgMemberExistsByEmail(ctx context.Context, orgID, email string) (bool, error) {
	email = strings.ToLower(strings.TrimSpace(email))
	if email == "" {
		return false, nil
	}

	return c.OrgMembership.Query().
		Where(
			orgmembership.OrganizationIDEQ(orgID),
			orgmembership.HasUserWith(user.EmailEQ(email)),
		).
		Exist(ctx)
}

// CreateNotificationsForUsers creates one notification per distinct user from the shared
// input, normalizing the object type, and returns the user IDs actually notified
func (c *Client) CreateNotificationsForUsers(ctx context.Context, userIDs []string, input CreateNotificationInput) ([]string, error) {
	userIDs = lo.Uniq(lo.Compact(userIDs))
	if len(userIDs) == 0 {
		return nil, nil
	}

	input.ObjectType = strcase.UpperSnakeCase(input.ObjectType)

	for _, userID := range userIDs {
		if _, err := c.Notification.Create().SetInput(input).SetUserID(userID).Save(ctx); err != nil {
			return nil, err
		}
	}

	return userIDs, nil
}

// FullName returns the user's human-readable name: the display name when set, the
// first/last composition otherwise, falling back to the email address
func (u *User) FullName() string {
	if name := strings.TrimSpace(u.DisplayName); name != "" {
		return name
	}

	if name := strings.TrimSpace(strings.TrimSpace(u.FirstName) + " " + strings.TrimSpace(u.LastName)); name != "" {
		return name
	}

	return u.Email
}

