import "context"

// edgeCleanups maps a schema name to its edge cleanup, filled by the edge cleanup file, which code generation excludes
var edgeCleanups = map[string]func(ctx context.Context, id string) error{}

// EdgeCleanupFor returns the schema's edge cleanup, nil when the schema has none or during code generation
func EdgeCleanupFor(schema string) func(ctx context.Context, id string) error {
	return edgeCleanups[schema]
}
