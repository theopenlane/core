    "credentials": [
      {
        "ref": "CredentialSchema",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/aikido/credential-schema",
          "$ref": "#/$defs/CredentialSchema",
          "$defs": {
            "CredentialSchema": {
              "properties": {
                "clientId": {
                  "type": "string",
                  "title": "Client ID",
                  "description": "Client ID from Aikido Settings \u003e Integrations \u003e REST API."
                },
                "clientSecret": {
                  "type": "string",
                  "title": "Client Secret",
                  "description": "Client secret paired with the client ID."
                },
                "region": {
                  "type": "string",
                  "enum": [
                    "eu",
                    "us",
                    "au",
                    "me"
                  ],
                  "title": "Region",
                  "description": "Region hosting your Aikido workspace. Leave blank for the default EU region (app.aikido.dev).",
                  "default": "eu"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "clientId",
                "clientSecret"
              ]
            }
          }
        }
      },
      {
        "ref": "aikidoOAuthCred",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/aikido/aikido-o-auth-cred",
          "$ref": "#/$defs/aikidoOAuthCred",
          "$defs": {
            "aikidoOAuthCred": {
              "properties": {
                "accessToken": {
                  "type": "string"
                },
                "refreshToken": {
                  "type": "string"
                },
                "expiry": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "additionalProperties": false,
              "type": "object"
            }
          }
        }
      }
    ],
    "installation": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/aikido/installation-metadata",
