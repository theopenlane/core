                "title": "Workspace"
              },
              "region": {
                "type": "string",
                "title": "Region"
              },
              "linkedProvider": {
                "type": "string",
                "title": "Linked Provider"
              }
            },
            "additionalProperties": false,
            "type": "object"
          }
        }
      }
    },
