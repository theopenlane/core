  "surface": {
    "id": "def_01EMAILINT00000000000000001",
    "credentials": [
      {
        "ref": "PostmarkCredential",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/email/postmark-credential",
          "$ref": "#/$defs/PostmarkCredential",
          "$defs": {
            "PostmarkCredential": {
              "properties": {
                "serverToken": {
                  "type": "string",
                  "description": "Postmark server API token"
                },
                "messageStream": {
                  "type": "string",
                  "description": "Postmark message stream ID (defaults to outbound)"
                },
                "trackOpens": {
                  "type": "boolean",
                  "description": "Enable Postmark open tracking"
                },
                "trackLinks": {
                  "type": "string",
                  "enum": [
                    "None",
                    "HtmlAndText",
                    "HtmlOnly",
                    "TextOnly"
                  ],
                  "description": "Postmark link tracking mode"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "serverToken"
              ]
            }
          }
        }
      },
      {
        "ref": "ResendCredential",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/email/resend-credential",
          "$ref": "#/$defs/ResendCredential",
          "$defs": {
            "ResendCredential": {
              "properties": {
                "apiKey": {
                  "type": "string",
                  "description": "Resend API key"
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "apiKey"
              ]
            }
          }
        },
        "replaces": [
          "Credential"
        ]
      }
    ],
    "userInput": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/email/user-input",
        "$ref": "#/$defs/UserInput",
        "$defs": {
          "UserInput": {
            "properties": {
              "fromEmail": {
                "type": "string",
                "description": "Email address your emails are sent from using your configured provider key"
              },
              "companyName": {
                "type": "string",
                "description": "Company display name shown in the email footer"
              },
              "companyAddress": {
                "type": "string",
                "description": "Company mailing address shown in the email footer for CAN-SPAM compliance"
              }
            },
            "additionalProperties": false,
            "type": "object",
            "required": [
              "fromEmail",
              "companyName"
            ]
          }
        }
      }
    },
    "installation": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/email/installation-metadata",
        "$ref": "#/$defs/InstallationMetadata",
        "$defs": {
          "InstallationMetadata": {
            "properties": {
              "provider": {
                "type": "string"
              },
              "fromEmail": {
                "type": "string"
              }
            },
            "additionalProperties": false,
            "type": "object"
          }
        }
      }
    },
