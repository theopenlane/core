{
  "hash": "3c2d8fa4a6cc78936c24c6e3c57df1f26e1185b021894d3358d27b4f1b5127a5",
  "version": "01M6PY3C0E2BD88C0C0AY8G9KS",
  "surface": {
    "id": "def_01K0FOSSA00000000000000001",
    "credentials": [
      {
        "ref": "CredentialSchema",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/fossa/credential-schema",
          "$ref": "#/$defs/CredentialSchema",
          "$defs": {
            "CredentialSchema": {
              "properties": {
                "apiToken": {
                  "type": "string",
                  "title": "API Token",
                  "description": "Full API token from a FOSSA service account. Push-only tokens cannot read issues. Read scope is controlled by the service account role."
                },
                "baseUrl": {
                  "type": "string",
                  "title": "Base URL",
                  "description": "FOSSA base URL. Leave blank to use https://app.fossa.com."
                }
              },
              "additionalProperties": false,
              "type": "object",
              "required": [
                "apiToken"
              ]
            }
          }
        }
      }
    ],
    "installation": {
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/fossa/installation-metadata",
        "$ref": "#/$defs/InstallationMetadata",
        "$defs": {
          "InstallationMetadata": {
            "properties": {
              "organizationId": {
                "type": "string",
                "title": "Organization ID"
              },
              "baseUrl": {
                "type": "string",
                "title": "Base URL"
              },
              "subscription": {
                "type": "string",
                "title": "Subscription"
              }
            },
            "additionalProperties": false,
            "type": "object"
          }
        }
      }
    },
    "connections": [
      "CredentialSchema"
    ],
    "operations": [
      {
        "name": "VulnerabilitySync",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "$id": "https://github.com/theopenlane/core/v2/internal/integrations/definitions/fossa/vulnerability-sync",
          "$ref": "#/$defs/VulnerabilitySync",
          "$defs": {
            "VulnerabilitySync": {
              "properties": {
                "disable": {
                  "type": "boolean",
                  "title": "Disable",
                  "description": "Disable this operation for the installation"
                },
                "filterExpr": {
                  "type": "string",
                  "title": "Filter Expression",
                  "description": "Optional CEL expression applied to records before ingesting"
                },
                "enableLicenseFindings": {
                  "type": "boolean",
                  "title": "Enable License Compliance Findings",
                  "description": "Also collect FOSSA OSS license policy issues as findings. Security vulnerabilities are always collected."
                },
                "includeIgnored": {
                  "type": "boolean",
                  "title": "Include Ignored Issues",
                  "description": "Include issues already dismissed in FOSSA when the integration is first connected. Later syncs always pick up dismissals so issues closed in FOSSA are closed here too."
                }
              },
              "additionalProperties": false,
              "type": "object"
            }
          }
        }
      }
    ]
  }
}
