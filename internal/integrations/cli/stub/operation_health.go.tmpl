package {{ name }}

import (
	"context"
	"encoding/json"

	"github.com/theopenlane/core/v2/internal/integrations/providerkit"
	"github.com/theopenlane/core/v2/internal/integrations/types"
	"github.com/theopenlane/core/v2/pkg/logx"
)

// HealthCheck holds the result of a {{ display }} health check
type HealthCheck struct {
	// Status is the verification status returned by {{ display }}
	Status string `json:"status,omitempty"`
}

// checkHealth verifies the stored {{ display }} credential still works
func checkHealth(ctx context.Context, req types.OperationRequest, c *APIClient) (json.RawMessage, error) {
	meta, err := resolveCredential(req.Credentials)
	if err != nil {
		logx.FromContext(ctx).Error().Err(err).Msg("{{ name }}: error resolving credentials")
		return nil, err
	}

	if meta.AccountID == "" || c.Credential.APIToken == "" {
		logx.FromContext(ctx).Error().Msg("{{ name }}: healthcheck failed")
		return nil, ErrHealthCheckFailed
	}

	return providerkit.EncodeResult(HealthCheck{Status: "active"}, ErrResultEncode)
}
