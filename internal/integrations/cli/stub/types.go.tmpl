package {{ name }}

import (
	"github.com/theopenlane/core/v2/internal/integrations/types"
)

var (
	// definitionID is the stable identifier for the {{ display }} integration definition
	definitionID = types.NewDefinitionRef("{{ defid }}")
	// installation is the typed installation metadata handle for the {{ display }} definition
	installation = types.InstallationOf[InstallationMetadata]()
	// {{ name }}Connection is the typed connection handle for the {{ display }} API token
	{{ name }}Connection = types.ConnectionOf[CredentialSchema]()
)

// APIClient is the client handed to {{ display }} operations; swap this for the provider SDK client type
type APIClient struct {
	// Credential is the credential this client was built from
	Credential CredentialSchema
}

// CredentialSchema holds the {{ display }} credentials for one installation
type CredentialSchema struct {
	// APIToken is the token used to authenticate against {{ display }}
	APIToken string `json:"apiToken" jsonschema:"required,title=API Token,secret=true,description=Token used to authenticate on your behalf to {{ display }}"`
	// AccountID is the {{ display }} account identifier used for account-scoped API calls
	AccountID string `json:"accountId,omitempty" jsonschema:"required,title=Account ID,description=Account identifier collection is scoped to"`
}

// InstallationMetadata holds the stable {{ display }} account identity for one installation
type InstallationMetadata struct {
	// AccountID is the {{ display }} account identifier used for account-scoped collection
	AccountID string `json:"accountId,omitempty" jsonschema:"title=Account ID"`
}

// InstallationIdentity implements types.InstallationIdentifiable
func (m InstallationMetadata) InstallationIdentity() types.IntegrationInstallationIdentity {
	return types.IntegrationInstallationIdentity{
		ExternalID: m.AccountID,
	}
}
