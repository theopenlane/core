package {{ name }}

import (
	"github.com/theopenlane/core/v2/internal/integrations/registry"
	"github.com/theopenlane/core/v2/internal/integrations/types"
)

// Builder returns the {{ display }} definition builder
func Builder() registry.Builder {
	return registry.Builder(func() (types.Definition, error) {
		return types.Definition{
			ID:           definitionID.ID(),
			Family:       "{{ family }}",
			DisplayName:  "{{ display }}",
			Description:  "Collect data from {{ display }}.",
			Category:     "{{ category }}",
			DocsURL:      "https://docs.theopenlane.io/docs/platform/integrations/{{ slug }}",
			Tags:         []string{"assets"},
			Active:       false,
			Visible:      true,
			HealthCheck:  {{ name }}Client.HealthCheck(checkHealth),
			Installation: installation.Registration(),
			CredentialRegistrations: []types.CredentialRegistration{
				{{ name }}Credential.Registration(types.CredentialRegistration{
					Name:        "{{ display }} Credential",
					Description: "API token used to access {{ display }}.",
				}),
			},
			Connections: []types.ConnectionRegistration{
				{
					CredentialRef: {{ name }}Credential.ID(),
					Name:          "{{ display }} API Token",
					Description:   "Configure {{ display }} access using an API token scoped to your account.",
					Disconnect: &types.DisconnectRegistration{
						CredentialRef: {{ name }}Credential.ID(),
						Description:   "Removes the stored API token from Openlane. If the token is no longer needed, revoke it in your {{ display }} account.",
					},
				},
			},
			Clients: []types.ClientRegistration{
				{{ name }}Client.Registration(Client{}.Build, types.ClientRegistration{
					Description: "{{ display }} API client",
				}),
			},
		}, nil
	})
}
