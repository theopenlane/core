func buildClient(_ context.Context, req types.ConnectionRequest[CredentialSchema]) (*APIClient, error) {
	if req.Credential.APIToken == "" {
		return nil, ErrAPITokenMissing
	}

	// swap the placeholder for the provider SDK constructor, e.g. sdk.NewClient(req.Credential.APIToken)
